import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();        // size of array
        int[] arr = new int[n];

        // reading array elements
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        // find maximum
        int max = arr[0];
        for (int i = 1; i < n; i++) {
            if (arr[i] > max) {
                max = arr[i];
            }
        }

        System.out.println(max);
    }
}
